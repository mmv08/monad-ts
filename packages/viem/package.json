{
  "name": "@monad-crypto/viem",
  "version": "0.0.3",
  "private": true,
  "description": "TypeScript Interface for Monad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monad-crypto/monad-ts.git",
    "directory": "packages/viem"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./encrypted": {
      "types": "./dist/encrypted/index.d.ts",
      "default": "./dist/encrypted/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "test:encrypted": "bun run build && bun test test/encrypted",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "typescript": ">=5.4.0",
    "viem": ">=2.56.8 <3"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@monad-crypto/btx": "workspace:*",
    "ox": "0.14.45"
  },
  "devDependencies": {
    "viem": "2.56.8"
  }
}
